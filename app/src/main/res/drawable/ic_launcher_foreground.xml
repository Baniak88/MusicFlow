<?xml version="1.0" encoding="utf-8"?>
<!-- Glass ring around a violet→magenta play button (the player's play control). Kept inside the
     66 dp safe zone of adaptive icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <!-- Frosted glass ring -->
    <path android:fillColor="#2EFFFFFF" android:strokeColor="#66FFFFFF" android:strokeWidth="1.2"
        android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0" />
    <!-- Gradient play disc -->
    <path android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="36" android:startY="36" android:endX="72" android:endY="72"
                android:startColor="#FF7C3AED" android:endColor="#FFD946EF" />
        </aapt:attr>
    </path>
    <!-- Soft highlight -->
    <path android:fillColor="#26FFFFFF"
        android:pathData="M36,48a19,19 0,0 1,30 -12a22,22 0,0 0,-30 12z" />
    <!-- Rounded play symbol -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M48.5,44.6c0,-2.2 2.4,-3.6 4.3,-2.4l11.9,7.4c1.8,1.1 1.8,3.7 0,4.8l-11.9,7.4c-1.9,1.2 -4.3,-0.2 -4.3,-2.4z" />
</vector>
